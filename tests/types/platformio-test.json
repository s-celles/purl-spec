      "description": "Parse test for PURL type: platformio with namespace, name and version",
      "test_group": "base",
      "test_type": "parse",
      "input": "pkg:platformio/me-no-dev/asynctcp@1.1.1",
      "expected_output": {
        "type": "platformio",
        "namespace": "me-no-dev",
        "name": "asynctcp",
        "version": "1.1.1",
        "qualifiers": null,
        "subpath": null
      },
      "expected_failure": false,
      "expected_failure_reason": null
    },
    {
      "description": "Roundtrip test for PURL type: platformio",
      "test_group": "base",
